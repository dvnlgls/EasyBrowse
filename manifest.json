{
  "manifest_version": 2,
  "name": "EasyBrowse",
  "version": "1.1.0",
  "description": "A Firefox Android add-on with a floating browsing controller",
  "permissions": ["tabs", "storage", "clipboardWrite"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "EasyBrowse@epoweri.com",
      "strict_min_version": "109.0"
    }
  }
}
